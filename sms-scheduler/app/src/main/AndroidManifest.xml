<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Send SMS from the device's own SIM -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <!-- Show a notification when a scheduled message is sent / fails -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Fire alarms at an exact wall-clock time -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- Re-arm pending messages after a reboot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- This app requires telephony to actually send SMS -->
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmsScheduler">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Fired by AlarmManager when it is time to send a message -->
        <receiver
            android:name=".SendSmsReceiver"
            android:exported="false" />

        <!-- Fired by the system result of SmsManager.sendTextMessage -->
        <receiver
            android:name=".SmsSentReceiver"
            android:exported="false" />

        <!-- Re-schedules pending messages after the phone reboots -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
