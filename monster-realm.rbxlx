qHint.Size = UDim2.fromOffset(60, 16)
qHint.BackgroundTransparency = 1
qHint.Text = "[J]"
qHint.Font = Enum.Font.Gotham
qHint.TextSize = 11
qHint.TextColor3 = Color3.fromRGB(220, 220, 220)
qHint.Parent = qBtn

qBtn.MouseButton1Click:Connect(toggleJournal)
]]></string>
